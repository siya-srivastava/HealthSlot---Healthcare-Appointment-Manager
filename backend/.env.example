# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (required)
# Use a MongoDB Atlas URI for cloud deployments
MONGODB_URI=mongodb://localhost:27017/healthcare_appointment

# Authentication (required)
# Generate a secure random string of at least 32 characters
JWT_SECRET=your_jwt_secret_minimum_32_characters_long

# Email - Brevo HTTP API (required for appointment confirmation emails)
# Sign up free at https://app.brevo.com
# Navigate to Settings > API Keys > Generate a new API key
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
EMAIL_USER=your-verified-sender@gmail.com

# LLM Integration (optional)
# If both are omitted, the system uses a built-in keyword-based triage fallback

# Option A: Google Gemini API (recommended)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option B: Ollama running locally
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3

# Google Calendar OAuth 2.0 (optional)
# See README.md for full setup instructions
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
