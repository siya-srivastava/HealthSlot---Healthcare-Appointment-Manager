# Healthcare Appointment & Follow-up Manager - Environment Configuration

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGO_URI=mongodb://localhost:27017/healthcare_appointment
# Example MongoDB Atlas URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/healthcare_appointment?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production_2026

# LLM Providers (Gemini API or Ollama)
# 1. Google Gemini API (Recommended for cloud/easy setup):
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Local Ollama (Optional):
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3

# Email Service (Nodemailer with Gmail / SendGrid / SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_specific_password

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
